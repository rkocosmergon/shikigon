#!/bin/bash -p
# -p: no BASH_ENV, no exported function. A relative one ran from the folder this was started in,
# before any line here (cos20 #492, betreuer pass 026bb73, B1).
# Opens the Cosmergon terminal client (cosmergon-dashboard) for this Shikigon's agent.
# The key goes to the dashboard over a pipe (--api-key-fd), never as an argument and never in
# its environment: arguments are visible in the process list, and /proc/<pid>/environ keeps a
# process's starting environment for its whole life (cos20 #492 B7).
set -euo pipefail
# Every file the dashboard and its SDK make is the player's alone, as in shikigon-wake: the SDK
# wrote ~/.cosmergon/config.toml with this shell's umask before it set 0600 (cos20 #492, fourth
# review, K2; the SDK makes it 0600 from creation since 0.27.32).
umask 077
# Programs only from the absolute folders of PATH, as in the brain (connections.absolute_path)
# and the bar (Model.PATH_RULE, the same line): an empty or relative entry is a folder of
# wherever this was started, which another user may write, and bash looks there (cos20 #492,
# betreuer pass c01ec84, F1). Builtins only up to here; what this starts inherits it.
given="${PATH:-}:"; PATH=""; while [ -n "$given" ]; do case "${given%%:*}" in /*) PATH="${PATH:+$PATH:}${given%%:*}" ;; esac; given="${given#*:}"; done; export PATH="${PATH:-/bin:/usr/bin}";
# The state folder: $XDG_STATE_HOME only if it is an absolute path, as in the brain
# (files.xdg_home) and the bar (Model.stateHome); a relative one would put the talk and the
# advisor's key in whatever folder this was started from (cos20 #492, betreuer pass ead8263).
case "${XDG_STATE_HOME:-}" in
    /*) state="$XDG_STATE_HOME/shikigon" ;;
    *) state="$HOME/.local/state/shikigon" ;;
esac
venv="$HOME/.local/share/shikigon/venv"
if [ ! -f "$state/credentials.json" ]; then
    echo "No Shikigon lives here yet. Wake it from the bar first."
    read -r -p "Press Enter to close." _
    exit 1
fi
brain="$(cd "$(dirname "$0")" && pwd)/shikigon_brain.py"
# The dashboard talks only to cosmergon.com and has no port check of its own: a Shikigon of
# another world keeps its key out of it (terminal_refusal in shikigon_brain.py; H3, K9).
# With -I, like every other start of Python here: without it an empty entry of PYTHONPATH is the
# folder this was started in, before the standard library (betreuer pass 026bb73, B1). -I leaves
# the brain's folder off sys.path, which kept the terminal shut at 22802ba; since 0.1.14 the brain
# puts it there itself (betreuer pass c01ec84, F3).
if ! why=$("$venv/bin/python" -I "$brain" terminal); then
    echo "$why"
    read -r -p "Press Enter to close." _
    exit 1
fi
# [M] in the terminal asks the same advisor as "ask" in the bar: the dashboard runs this
# command, gives it the question on stdin (cosmergon-agent >= 0.27.10; never as an argument,
# which every local user could read) and shows what it prints. The command gets no key; the
# brain reads its own key file.
COSMERGON_ADVISOR_CMD="$(printf '%q %s %q ask' "$venv/bin/python" -I "$brain")"
export COSMERGON_ADVISOR_CMD
# The talk so far: the brain writes every question and answer to this file (chat_path() in
# shikigon_brain.py). The dashboard reads it and opens [M] with the last ten exchanges; PgUp
# fetches older ones. Needs cosmergon-agent >= 0.27.6; an older dashboard ignores it.
export COSMERGON_ADVISOR_HISTORY="$state/chat.jsonl"
# The key on descriptor 3, from a pipe the dashboard reads to its end and closes
# (cosmergon-agent >= 0.27.30). Through its module: the console script starts Python without -I.
exec "$venv/bin/python" -I -m cosmergon_agent.dashboard --api-key-fd 3 \
    3< <("$venv/bin/python" -I -c 'import json,sys; print(json.load(open(sys.argv[1]))["api_key"])' "$state/credentials.json")
